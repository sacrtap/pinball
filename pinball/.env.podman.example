# 「幻想兔」弹珠机预测系统 — Podman 部署环境变量
# cp .env.podman.example .env.podman 后填写
# 使用：podman compose -f docker-compose.podman.yml --env-file .env.podman up -d --build

# ---- PostgreSQL ----
POSTGRES_DB=pinball
POSTGRES_USER=pinball
POSTGRES_PASSWORD=pinball

# ---- Auth.js ----
# 生成：openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# 应用外部地址（通过 Cloudflare Tunnel 暴露的域名）
AUTH_URL=https://pinball.jqmro.com

# ---- OAuth（留空则 provider 不启用，代码就位不阻塞）----
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- 邮件 OTP ----
# console=开发模式只打日志不发信；smtp=走 nodemailer；resend=走 Resend SDK
EMAIL_MODE=console
EMAIL_FROM=no-reply@pinball.jqmro.com
# SMTP 模式（EMAIL_MODE=smtp）：示例 smtps://user:pass@smtp.example.com:465
EMAIL_SERVER=
# Resend 模式（EMAIL_MODE=resend）
RESEND_API_KEY=

# 测试路由开关（生产切勿开启）
ENABLE_TEST_ROUTES=false

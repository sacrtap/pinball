# 「幻想兔」弹珠机预测系统 — 环境变量示例
# cp .env.example .env 后填写；生产务必修改所有密钥。

# ---- 数据库 ----
# 本地开发（无 Docker）：直连本机 PG。
# 端口按实际实例填写：Postgres.app 默认 5432；本仓库开发用独立实例 5433
# （Postgres.app 的 auth_permission_dialog 共享库会阻塞后台服务的 TCP 连接）。
# DIRECT_DATABASE_URL 指向 postgres:5432（Docker 部署时用于 prisma migrate deploy 直连，不经 pgbouncer）
DIRECT_DATABASE_URL="postgresql://pinball_app:pinball_app_dev@127.0.0.1:5432/pinball_dev?schema=public"
DATABASE_URL="postgresql://pinball_app:pinball_app_dev@127.0.0.1:5432/pinball_dev?schema=public"
# L4 全局先验聚合角色连接（BYPASSRLS，仅供 BullMQ 聚合 job 使用，不暴露给请求路径）。
# 缺省时由 DATABASE_URL 替换凭据推导，本地已建 pinball_agg 角色可显式指定：
# AGG_DATABASE_URL="postgresql://pinball_agg:pinball_agg_dev@127.0.0.1:5432/pinball_dev?schema=public"

# ---- Redis（BullMQ 队列）----
REDIS_URL="redis://127.0.0.1:6379"

# ---- Auth.js ----
# 生成：openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
# 应用外部地址（生产务必 https）；NEXTAUTH_URL 为兼容别名，二者同义
NEXTAUTH_URL="http://localhost:8477"
AUTH_URL="http://localhost:8477"

# ---- OAuth（留空则 provider 不启用，代码就位不阻塞）----
# Google Cloud Console → OAuth 同意屏幕 → 凭据；回调 http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GitHub → Settings → Developer settings → OAuth App；回调 http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- 邮件 OTP ----
# console=开发模式只打日志不发信；smtp=走 nodemailer；resend=走 Resend SDK
EMAIL_MODE="console"
EMAIL_FROM="no-reply@pinball.local"
# SMTP 模式（EMAIL_MODE=smtp）：示例 smtps://user:pass@smtp.example.com:465
EMAIL_SERVER=""
# Resend 模式（EMAIL_MODE=resend）
RESEND_API_KEY=""

# 测试路由开关（E2E 用；生产切勿开启）
# ENABLE_TEST_ROUTES="true"
